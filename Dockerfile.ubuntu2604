# syntax=docker/dockerfile:1
FROM golang:1.27.3-trixie AS pebble-builder

RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    GOBIN=/out go install github.com/canonical/pebble/cmd/pebble@v1.33.2

FROM ubuntu:26.04

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get -y install python3.14-minimal zlib1g gawk sed jq tar unzip git curl wget redir socat traceroute net-tools iproute2 iputils-ping mtr-tiny haproxy rsync httpie

COPY --from=pebble-builder /out/pebble /usr/bin/pebble
