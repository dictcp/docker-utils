FROM golang:1.27.3-trixie AS builder

WORKDIR /build/wireproxy
COPY go-tools/wireproxy/go.mod go-tools/wireproxy/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=readonly -trimpath -o /go/bin/wireproxy github.com/windtf/wireproxy/cmd/wireproxy

WORKDIR /build/derper
COPY go-tools/derper/go.mod go-tools/derper/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=readonly -trimpath -o /go/bin/derper tailscale.com/cmd/derper

WORKDIR /build/sniproxy
COPY go-tools/sniproxy/go.mod go-tools/sniproxy/go.sum ./
COPY patches/sniproxy-v1.6.1-dnsproxy.patch ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go mod download github.com/ameshkov/sniproxy@v1.6.1 && \
    cp -a "$(go env GOMODCACHE)/github.com/ameshkov/sniproxy@v1.6.1" ./upstream && \
    chmod -R u+w ./upstream && \
    git apply --directory=upstream sniproxy-v1.6.1-dnsproxy.patch && \
    go mod edit -replace=github.com/ameshkov/sniproxy=./upstream && \
    go build -mod=readonly -trimpath -o /go/bin/sniproxy github.com/ameshkov/sniproxy

FROM debian:trixie-slim

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get -y install \
    gawk sed jq tar unzip git curl wget \
    redir socat traceroute net-tools iproute2 iputils-ping mtr-tiny iperf3 \
    haproxy rsync httpie \
    python3-minimal ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /go/bin/wireproxy /usr/local/bin/
COPY --from=builder /go/bin/derper /usr/local/bin/
COPY --from=builder /go/bin/sniproxy /usr/local/bin/
